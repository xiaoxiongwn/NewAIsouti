<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="12dp"
    android:layout_marginTop="12dp">

    <!-- 第一行：设为当前使用 + 测试 + 删除 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <RadioButton
            android:id="@+id/rbActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#1565C0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设为当前使用"
            android:textSize="12sp"
            android:textColor="#555555" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTest"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试"
            android:textColor="#1565C0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除"
            android:textColor="#CC3333" />

    </LinearLayout>

    <!-- 名称单独占一整行，不再跟按钮挤在一起，确保能看见、能编辑 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="名称（自己起个好认的名字）"
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="例如：GPT-4o、豆包视觉"
        android:inputType="text"
        android:textStyle="bold"
        android:textColor="#111111"
        android:textColorHint="#999999" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="接口地址 (Base URL)"
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etBase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://api.deepseek.com/v1"
        android:inputType="textUri"
        android:textColor="#111111"
        android:textColorHint="#999999" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API Key"
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="任意平台的 Key，如 sk-... 或 ark-..."
        android:inputType="textPassword"
        android:textColor="#111111"
        android:textColorHint="#999999" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="模型名 (Model)"
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="deepseek-chat"
        android:inputType="text"
        android:textColor="#111111"
        android:textColorHint="#999999" />

</LinearLayout>
